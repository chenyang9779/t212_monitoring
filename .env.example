# ──────────────────────────────────────────────────────────────────────────────
# Trading 212 Position Monitor – environment variables
# ──────────────────────────────────────────────────────────────────────────────

# ── Synthetic demo mode (screenshots / no broker) ──────────────────────────
# Set to true to skip all Trading 212 API calls and use fully synthetic data.
# No API credentials are required.  Database defaults to data/demo-monitor.db.
T212_DEMO=true

# ── Broker credentials (omit when T212_DEMO=true) ─────────────────────────
# Use a **read-only** API key from Trading 212.
T212_API_KEY=
T212_API_SECRET=
# Environment: "demo" (sandbox) or "live" (real account).
T212_ENV=demo

# ── Polling / snapshot intervals (seconds) ─────────────────────────────────
T212_POLL_SECONDS=6
T212_SNAPSHOT_SECONDS=30

# ── Database path (SQLite) ─────────────────────────────────────────────────
# Live / demo mode:          data/monitor.db
# Demo mode (default when T212_DEMO=true): data/demo-monitor.db
T212_DB_PATH=data/monitor.db

# ── Optional retention policy (days) ───────────────────────────────────────
# Delete raw account/position snapshots older than N days.
# Blank / unset disables automatic cleanup.
T212_RAW_RETENTION_DAYS=

# ── Optional alert thresholds (percent) ────────────────────────────────────
T212_POSITION_LOSS_ALERT_PCT=
T212_TOTAL_LOSS_ALERT_PCT=

# ── Docker Compose host publishing ─────────────────────────────────────────
# Binds the *published* host port.  The container still listens on 0.0.0.0
# so Docker port forwarding works correctly.  Default: localhost only.
T212_BIND_ADDRESS=127.0.0.1
T212_HOST_PORT=8000
