T212_API_KEY=
T212_API_SECRET=
T212_ENV=demo
T212_POLL_SECONDS=6
T212_SNAPSHOT_SECONDS=30
T212_DB_PATH=data/monitor.db
# Optional: delete raw account/position snapshots and sampled market quotes older than N days.
# Blank disables automatic retention cleanup.
T212_RAW_RETENTION_DAYS=
T212_POSITION_LOSS_ALERT_PCT=
T212_TOTAL_LOSS_ALERT_PCT=

# Docker Compose host publishing. Set T212_BIND_ADDRESS=127.0.0.1 for local-only access.
T212_BIND_ADDRESS=0.0.0.0
T212_HOST_PORT=8000
